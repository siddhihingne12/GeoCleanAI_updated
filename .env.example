# Copy to .env.local. Never commit the populated file.
# Click View under Access Token (not Client secret) in Mapillary's developer dashboard.
# This token is intentionally public in the browser bundle.
VITE_MAPILLARY_CLIENT_TOKEN=
# Use your Mapillary client access token here too. Never put an app secret in VITE_*.
MAPILLARY_ACCESS_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Identifies this application to the public geocoding service.
NOMINATIM_USER_AGENT=GeoCleanAI-college-demo/0.1 (replace-with-your-project-url-or-contact)
# Local single-process development only. Never enabled on Vercel.
ALLOW_LOCAL_CACHE=1
MODEL_PATH=models/litter.onnx
MODEL_MANIFEST_PATH=models/manifest.json
